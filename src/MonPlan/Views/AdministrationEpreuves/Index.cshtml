@model RechercheEpreuvesAdminViewModel
@{ ViewData["Title"] = "Épreuves"; }
<div class="page-heading"><div><p class="eyebrow">Administration</p><h1>Épreuves</h1></div><a class="button" asp-action="Creer">Ajouter une épreuve</a></div>
@if(TempData["Succes"] is string s){<div class="alert success">@s</div>}
<form method="get" class="filters"><label>Texte<input asp-for="Texte" /></label><label>Manifestation<select asp-for="ManifestationId"><option value="">Toutes</option>@foreach(var m in Model.Manifestations){<option value="@m.Id">@m.Nom</option>}</select></label><label>Ville<input asp-for="Ville" /></label><label>Discipline<select asp-for="Discipline" asp-items="Html.GetEnumSelectList<DisciplineSportive>()"><option value="">Toutes</option></select></label><label>Du<input asp-for="DateDebut" type="date" /></label><label>Au<input asp-for="DateFin" type="date" /></label><label>État<select asp-for="EstActive"><option value="">Tous</option><option value="true">Actif</option><option value="false">Inactif</option></select></label><button class="button" type="submit">Rechercher</button></form>
<div class="table-scroll"><table><thead><tr><th>Manifestation</th><th>Épreuve</th><th>Discipline</th><th>Format</th><th>Ville</th><th>Date</th><th>Départ</th><th>État</th><th></th></tr></thead><tbody>@foreach(var e in Model.Resultats){<tr><td>@e.Manifestation</td><td>@e.Nom</td><td>@e.Discipline.Libelle()</td><td>@e.Format</td><td>@e.Ville</td><td>@e.DateEpreuve.ToString("dd/MM/yyyy")</td><td>@e.HeureDepart?.ToString("HH\\:mm")</td><td><span class="badge @(e.EstActive ? "active" : "inactive")">@(e.EstActive ? "Actif" : "Inactif")</span></td><td><a asp-action="Details" asp-route-id="@e.Id">Détail</a> · <a asp-action="Modifier" asp-route-id="@e.Id">Modifier</a></td></tr>}</tbody></table></div>
