@model EpreuveAdminViewModel
@{ ViewData["Title"] = Model.Nom; }
<div class="page-heading"><div><p class="eyebrow">Administration · Épreuve</p><h1>@Model.Nom</h1><p>@Model.Manifestation · @Model.Ville</p></div><span class="badge @(Model.EstActive ? "active" : "inactive")">@(Model.EstActive ? "Actif" : "Inactif")</span></div>
@if(TempData["Succes"] is string s){<div class="alert success">@s</div>}@if(TempData["Erreur"] is string e){<div class="alert error">@e</div>}
<dl><dt>Discipline</dt><dd>@Model.Discipline.Libelle()</dd><dt>Format</dt><dd>@Model.Format</dd><dt>Distance</dt><dd>@Model.DescriptionDistance</dd><dt>Date et heure</dt><dd>@Model.DateEpreuve.ToString("dd/MM/yyyy") @Model.HeureDepart?.ToString("HH\\:mm")</dd></dl>
<div class="actions"><a class="button secondary" asp-action="Modifier" asp-route-id="@Model.Id">Modifier</a><form method="post" asp-action="Etat" asp-route-id="@Model.Id" onsubmit="return confirm('Confirmer cette action ?');"><input type="hidden" name="active" value="@(!Model.EstActive).ToString().ToLowerInvariant()"/><button class="button secondary" type="submit">@(Model.EstActive ? "Désactiver" : "Réactiver")</button></form>@if(!Model.EstUtilisee){<form method="post" asp-action="Supprimer" asp-route-id="@Model.Id" onsubmit="return confirm('Supprimer définitivement cette épreuve ?');"><button class="button danger" type="submit">Supprimer</button></form>}else{<span class="muted">Suppression impossible : cette épreuve est présente dans un plan. Tu peux la désactiver.</span>}</div>
