@model FormulaireEpreuveViewModel
@{ var creation = Model.Id == 0; ViewData["Title"] = creation ? "Ajouter une épreuve" : "Modifier l’épreuve"; }
<div class="page-heading"><div><p class="eyebrow">Administration</p><h1>@ViewData["Title"]</h1></div></div>
<form method="post" class="form-card"><div asp-validation-summary="ModelOnly" class="validation"></div>@if(!creation){<input asp-for="Id" type="hidden" />}
<label asp-for="ManifestationSportiveId"></label><select asp-for="ManifestationSportiveId" id="manifestation"><option value="">Choisir une manifestation</option>@foreach(var m in Model.Manifestations){<option value="@m.Id" data-dates="Du @m.DateDebut.ToString("dd/MM/yyyy") au @m.DateFin.ToString("dd/MM/yyyy")">@m.Nom</option>}</select><span asp-validation-for="ManifestationSportiveId"></span><p id="dates-manifestation" class="muted"></p>
<label asp-for="Nom"></label><input asp-for="Nom" /><span asp-validation-for="Nom"></span><label asp-for="Discipline"></label><select asp-for="Discipline" asp-items="Html.GetEnumSelectList<DisciplineSportive>()"><option value="">Choisir</option></select><span asp-validation-for="Discipline"></span>
<div class="form-grid"><div><label asp-for="Format"></label><input asp-for="Format" /></div><div><label asp-for="DateEpreuve"></label><input asp-for="DateEpreuve" type="date" /><span asp-validation-for="DateEpreuve"></span></div></div><label asp-for="DescriptionDistance"></label><textarea asp-for="DescriptionDistance"></textarea><label asp-for="HeureDepart"></label><input asp-for="HeureDepart" type="time" /><label class="check"><input asp-for="EstActive" /> Active</label><button class="button" type="submit">@(creation ? "Ajouter l’épreuve" : "Enregistrer")</button></form>
<script>const select=document.querySelector('#manifestation'),dates=document.querySelector('#dates-manifestation');function afficherDates(){dates.textContent=select.selectedOptions[0]?.dataset.dates||'';}select.addEventListener('change',afficherDates);afficherDates();</script>
