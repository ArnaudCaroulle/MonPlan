@model IReadOnlyList<SaisonListeViewModel>
@{ ViewData["Title"] = "Mes saisons"; }
<div class="page-heading"><div><p class="eyebrow">Espace personnel</p><h1>Mes saisons</h1></div><a asp-action="Creer" class="button">Créer une saison</a></div>
@if(TempData["Succes"] is string message){<div class="alert success">@message</div>}
@if(Model.Count == 0){<div class="empty-state"><h2>Aucune saison</h2><p>Crée ta première saison pour pouvoir ajouter une épreuve à ton plan.</p></div>}
else { <div class="season-list">@foreach(var saison in Model){<article><h2>@saison.Nom</h2><p>@saison.DateDebut.ToString("d MMM yyyy") – @saison.DateFin.ToString("d MMM yyyy")</p><p><strong>@saison.NombreEpreuves</strong> épreuve@(saison.NombreEpreuves > 1 ? "s" : "") associée@(saison.NombreEpreuves > 1 ? "s" : "")</p></article>}</div> }
