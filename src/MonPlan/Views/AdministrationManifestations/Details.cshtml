@model ManifestationAdminViewModel
@{ ViewData["Title"] = Model.Nom; }
<div class="page-heading"><div><p class="eyebrow">Administration · Manifestation</p><h1>@Model.Nom</h1><p>@Model.Ville (@Model.CodePostal), @Model.Pays · du @Model.DateDebut.ToString("dd/MM/yyyy") au @Model.DateFin.ToString("dd/MM/yyyy")</p></div><span class="badge @(Model.EstActive ? "active" : "inactive")">@(Model.EstActive ? "Actif" : "Inactif")</span></div>
@if(TempData["Succes"] is string s){<div class="alert success">@s</div>}@if(TempData["Erreur"] is string e){<div class="alert error">@e</div>}
<p>@Model.Description</p>@if(!string.IsNullOrWhiteSpace(Model.UrlSiteOfficiel)){<p><a href="@Model.UrlSiteOfficiel" rel="noopener" target="_blank">Site officiel</a></p>}
<div class="actions"><a class="button secondary" asp-action="Modifier" asp-route-id="@Model.Id">Modifier</a><form method="post" asp-action="Etat" asp-route-id="@Model.Id" onsubmit="return confirm('Confirmer cette action ?');"><input type="hidden" name="active" value="@(!Model.EstActive).ToString().ToLowerInvariant()"/><button class="button secondary" type="submit">@(Model.EstActive ? "Désactiver" : "Réactiver")</button></form>@if(Model.NombreEpreuves == 0){<form method="post" asp-action="Supprimer" asp-route-id="@Model.Id" onsubmit="return confirm('Supprimer définitivement cette manifestation ?');"><button class="button danger" type="submit">Supprimer</button></form>}else{<span class="muted">Suppression impossible : cette manifestation contient des épreuves.</span>}</div>
<div class="page-heading"><h2>Épreuves</h2><a class="button" asp-controller="AdministrationEpreuves" asp-action="Creer" asp-route-manifestationId="@Model.Id">Ajouter une épreuve</a></div>
<div class="table-scroll"><table><thead><tr><th>Nom</th><th>Discipline</th><th>Format</th><th>Date</th><th>État</th><th></th></tr></thead><tbody>@foreach(var item in Model.Epreuves){<tr><td>@item.Nom</td><td>@item.Discipline.Libelle()</td><td>@item.Format</td><td>@item.DateEpreuve.ToString("dd/MM/yyyy")</td><td><span class="badge @(item.EstActive ? "active" : "inactive")">@(item.EstActive ? "Actif" : "Inactif")</span></td><td><a asp-controller="AdministrationEpreuves" asp-action="Modifier" asp-route-id="@item.Id">Modifier</a></td></tr>}</tbody></table></div>
