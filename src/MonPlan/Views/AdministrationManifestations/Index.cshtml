@model RechercheManifestationsAdminViewModel
@{ ViewData["Title"] = "Manifestations"; }
<div class="page-heading"><div><p class="eyebrow">Administration</p><h1>Manifestations</h1></div><a class="button" asp-action="Creer">Créer une manifestation</a></div>
@if(TempData["Succes"] is string succes){<div class="alert success">@succes</div>}
<form method="get" class="filters"><label>Nom<input asp-for="Texte" /></label><label>Ville<input asp-for="Ville" /></label><label>Date<input asp-for="Date" type="date" /></label><label>État<select asp-for="EstActive"><option value="">Tous</option><option value="true">Actif</option><option value="false">Inactif</option></select></label><button class="button" type="submit">Rechercher</button></form>
<div class="table-scroll"><table><thead><tr><th>Nom</th><th>Ville</th><th>Code postal</th><th>Pays</th><th>Début</th><th>Fin</th><th>Épreuves</th><th>État</th><th>Actions</th></tr></thead><tbody>@foreach(var m in Model.Resultats){<tr><td>@m.Nom</td><td>@m.Ville</td><td>@m.CodePostal</td><td>@m.Pays</td><td>@m.DateDebut.ToString("dd/MM/yyyy")</td><td>@m.DateFin.ToString("dd/MM/yyyy")</td><td>@m.NombreEpreuves</td><td><span class="badge @(m.EstActive ? "active" : "inactive")">@(m.EstActive ? "Actif" : "Inactif")</span></td><td><a asp-action="Details" asp-route-id="@m.Id">Détail</a> · <a asp-action="Modifier" asp-route-id="@m.Id">Modifier</a></td></tr>}</tbody></table></div>
