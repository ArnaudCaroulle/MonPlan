@model IReadOnlyList<PlanSaisonViewModel>
@{ ViewData["Title"] = "Mon plan"; }
<div class="page-heading"><div><p class="eyebrow">Calendrier personnel</p><h1>Mon plan</h1></div><a asp-controller="Catalogue" asp-action="Index" class="button">Parcourir le catalogue</a></div>
@if(TempData["Succes"] is string message){<div class="alert success">@message</div>}
@if(Model.Count == 0){<div class="empty-state"><h2>Ton plan est vide</h2><p>Ajoute une première épreuve depuis le catalogue.</p></div>}
else { @foreach(var saison in Model){<section class="plan-season"><h2>@saison.Nom</h2><div class="plan-list">@foreach(var item in saison.Participations){<article class="plan-item"><time datetime="@item.DateEpreuve.ToString("yyyy-MM-dd")"><strong>@item.DateEpreuve.ToString("dd")</strong><span>@item.DateEpreuve.ToString("MMM")</span></time><div class="plan-content"><p class="muted">@item.Manifestation · @item.Ville</p><h3>@if(item.EstDisponible){<a asp-controller="Catalogue" asp-action="Details" asp-route-id="@item.EpreuveId">@item.Epreuve</a>}else{@item.Epreuve}</h3><p>@item.Discipline.Libelle() @if(!string.IsNullOrWhiteSpace(item.Format)){<span>· @item.Format</span>}</p>@if(!item.EstDisponible){<span class="badge inactive">Indisponible</span>}</div><span class="badge @(item.Statut == StatutParticipation.Inscrit ? "registered" : "planned")">@item.Statut.Libelle()</span></article>}</div></section>} }
