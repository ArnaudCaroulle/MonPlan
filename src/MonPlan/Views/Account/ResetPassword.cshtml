@model ReinitialiserMotDePasseViewModel
@{ ViewData["Title"] = "Nouveau mot de passe"; }
<h1>Nouveau mot de passe</h1><form method="post"><div asp-validation-summary="All"></div><input type="hidden" asp-for="Code" /><label>Email <input asp-for="Email" /></label><label>Mot de passe <input asp-for="MotDePasse" /></label><label>Confirmation <input asp-for="ConfirmationMotDePasse" /></label><button type="submit">Réinitialiser</button></form>
