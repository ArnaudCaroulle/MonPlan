<!doctype html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - MonPlan</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header class="topbar">
    <a asp-controller="Home" asp-action="Index" class="brand">MonPlan</a>
    <nav>
        <a asp-controller="Home" asp-action="Index">Accueil</a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-controller="Catalogue" asp-action="Index">Catalogue</a>
            <a asp-controller="Saisons" asp-action="Index">Mes saisons</a>
            <a asp-controller="Plan" asp-action="Index">Mon plan</a>
            <a asp-controller="Profile" asp-action="Index">Mon profil</a>
            <form asp-controller="Account" asp-action="Logout" method="post"><button type="submit">Déconnexion</button></form>
        }
        else
        {
            <a asp-controller="Account" asp-action="Register">Inscription</a>
            <a asp-controller="Account" asp-action="Login">Connexion</a>
        }
    </nav>
</header>
<main class="container">@RenderBody()</main>
</body>
</html>
